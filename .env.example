X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Gmail send, used by scripts/send_outreach.py. From a Google Cloud OAuth
# client (Desktop app type) with the Gmail API enabled.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
NOTION_API_TOKEN=
NOTION_TWEET_DRAFTS_DB_ID=5b1eb9c5f59183e8adf701ba357be880
NOTION_RESPONSE_CALENDAR_DB_ID=ec8eb9c5f591820393d101733079983f
NOTION_DISCOVERY_DB_ID=38ceb9c5f59183cf8e14015f0b5fa398
NOTION_PAPER_OUTREACH_DB_ID=
NOTION_PAPER_AUTHORS_DB_ID=
NOTION_COMPANY_RESEARCH_DB_ID=
# Typefully v2 API, used to schedule X posts/threads/replies.
# Get the key from typefully.com/settings/integrations; social set id
# from GET /v2/social-sets with that key.
TYPEFULLY_API_KEY=
TYPEFULLY_SOCIAL_SET_ID=

# Research outreach. Only OPENAI_API_KEY is needed; the rest are optional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# A contact address puts paper lookups on OpenAlex's polite pool (faster, higher limits).
OPENALEX_MAILTO=
# Without a key, Semantic Scholar rate-limits nearly every request.
SEMANTIC_SCHOLAR_API_KEY=

# Follow-up cadence for scripts/send_followups.py, both optional.
OUTREACH_FOLLOWUP1_DAYS=6
# Counted from Follow-up 1's send date, not the original message.
OUTREACH_FOLLOWUP2_DAYS=10
